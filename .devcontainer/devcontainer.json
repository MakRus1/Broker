{
  "name": "Broker (userver pg+grpc)",
  "workspaceFolder": "/workspaces/broker",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/broker,type=bind",
  "remoteUser": "builder",
  "containerEnv": {
    "SHELL": "/bin/bash"
  },
  "forwardPorts": [
    8080,
    8081,
    8082
  ],
  "postCreateCommand": "python3 scripts/container-images.py check && make check-gen-all && make cmake-debug",
  "runArgs": [],
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.makefile-tools",
        "vadimcn.vscode-lldb",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=${workspaceFolder}/.vscode",
          "--clang-tidy",
          "--completion-style=detailed",
          "--header-insertion=never"
        ],
        "clangd.path": "/usr/bin/clangd",
        "cmake.automaticReconfigure": false,
        "cmake.configureOnEdit": false,
        "cmake.configureOnOpen": false,
        "cmake.copyCompileCommands": "${workspaceFolder}/.vscode/compile_commands.json"
      }
    }
  },
  "mounts": [
    "source=broker-devcontainer-${devcontainerId}-_venv-gen,target=/workspaces/broker/.venv-gen,type=volume",
    "source=broker-devcontainer-${devcontainerId}-build-debug,target=/workspaces/broker/build-debug,type=volume",
    "source=broker-devcontainer-${devcontainerId}-build-release,target=/workspaces/broker/build-release,type=volume",
    "source=broker-devcontainer-${devcontainerId}-build-sanitize,target=/workspaces/broker/build-sanitize,type=volume"
  ],
  "image": "ghcr.io/makrus1/broker-dev@sha256:beeb3ce65b61b238baddf2d74f709be3516480aae24c28a54ebf8e5edb67d016"
}
