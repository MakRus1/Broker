{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build (Dev Container / Linux / CI)",
      "inherits": [
        "common-flags"
      ],
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build (Dev Container / Linux / CI)",
      "inherits": [
        "common-flags"
      ],
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "common-flags",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USERVER_FEATURE_GRPC": "ON",
        "USERVER_FEATURE_POSTGRESQL": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "sanitize",
      "inherits": [
        "debug"
      ],
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "USERVER_SANITIZE": "addr ub"
      }
    }
  ]
}
