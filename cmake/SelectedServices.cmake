# "all" — весь каталог; пустой список позволяет проверить только общие контракты.
set(BROKER_SERVICES "all" CACHE STRING "Сервисы для настройки: all или список имён")
option(BROKER_SHARED_CONTRACTS "Настраивать общие контрактные тесты" ON)

function(broker_add_selected_services)
    file(GLOB service_manifests CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/services/*/service.yaml")
    set(available_services)
    foreach(manifest IN LISTS service_manifests)
        get_filename_component(service_dir "${manifest}" DIRECTORY)
        get_filename_component(service_name "${service_dir}" NAME)
        list(APPEND available_services "${service_name}")
    endforeach()
    if(BROKER_SERVICES STREQUAL "all")
        set(selected_services ${available_services})
    else()
        # CMake принимает списки через ';', команды Make и CI передают имена через пробел.
        string(REPLACE " " ";" selected_services "${BROKER_SERVICES}")
        list(FILTER selected_services EXCLUDE REGEX "^$")
        list(REMOVE_DUPLICATES selected_services)
    endif()
    foreach(service IN LISTS selected_services)
        if(NOT service IN_LIST available_services)
            message(FATAL_ERROR "Неизвестный сервис: ${service}. Доступны: ${available_services}")
        endif()
    endforeach()
    message(STATUS "Выбранные сервисы: ${selected_services}")
    foreach(service IN LISTS selected_services)
        add_subdirectory("${CMAKE_SOURCE_DIR}/services/${service}")
    endforeach()
    if(BUILD_TESTING AND BROKER_SHARED_CONTRACTS)
        add_subdirectory("${CMAKE_SOURCE_DIR}/tests/fixtures/contract_service")
    endif()
endfunction()
