      "id": 601,
      "title": "Логи сервиса · trace_id → Tempo",
      "type": "logs",
      "description": "Окружение фильтруется как в метриках. Инстанс применяется только к метрикам: у логов пока нет соответствующего label.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 77,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"$service\",deployment_environment_name=~\"$environment\"} | level=~\"$level\" | json log_text=\"text\", log_body=\"body\", log_span=\"stopwatch_name\", log_status=\"meta_code\", log_kind=\"_type\" | line_format \"{{if .log_kind}}{{.log_kind}} {{end}}{{if .log_text}}{{.log_text}}{{else}}{{.log_span}}{{end}}{{if .log_status}} status={{.log_status}}{{end}}{{if .log_body}} body={{.log_body}}{{end}} trace_id={{.trace_id}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
