{
  "uid": "broker-service-counterparties",
  "title": "Broker · counterparties",
  "description": "Сгенерировано из service.yaml; изменения в JSON будут заменены make gen.",
  "tags": [
    "broker",
    "service",
    "counterparties"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "constant",
        "hide": 2,
        "query": "counterparties",
        "current": {
          "text": "counterparties",
          "value": "counterparties"
        }
      },
      {
        "name": "prometheus",
        "label": "Метрики",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "loki",
        "label": "Логи",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "environment",
        "label": "Окружение",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(engine_uptime_seconds{service=\"$service\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values(engine_uptime_seconds{service=\"$service\"}, environment)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Инстанс (метрики)",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(engine_uptime_seconds{service=\"$service\",environment=~\"$environment\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(engine_uptime_seconds{service=\"$service\",environment=~\"$environment\"}, instance)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "level",
        "label": "Уровень",
        "type": "custom",
        "query": "TRACE,DEBUG,INFO,WARNING,ERROR,CRITICAL",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "HTTP-сервер",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 101,
      "title": "HTTP: запросов / с",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_path) (rate(http_handler_rps{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\"}[$__rate_interval]))",
          "legendFormat": "{{http_path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 102,
      "title": "HTTP: 5xx / с",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_path) (rate(http_handler_reply_codes{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\",http_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{http_path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 103,
      "title": "HTTP: p95, максимум по инстансам",
      "type": "timeseries",
      "description": "Готовый p95 userver. Максимум локальных p95, а не общий p95 распределения; служебные ручки исключены.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(http_path) (http_handler_timings{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\",percentile=\"p95\"})",
          "legendFormat": "{{http_path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 104,
      "title": "HTTP: доля 5xx",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_handler_reply_codes{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\",http_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_handler_rps{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
