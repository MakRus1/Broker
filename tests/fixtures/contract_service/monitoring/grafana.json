{
  "uid": "broker-service-contract_service",
  "title": "Broker · contract_service",
  "description": "Сгенерировано из service.yaml; изменения в JSON будут заменены make gen.",
  "tags": [
    "broker",
    "service",
    "contract_service"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "constant",
        "hide": 2,
        "query": "contract_service",
        "current": {
          "text": "contract_service",
          "value": "contract_service"
        }
      },
      {
        "name": "prometheus",
        "label": "Метрики",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "environment",
        "label": "Окружение",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(engine_uptime_seconds{service=\"$service\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values(engine_uptime_seconds{service=\"$service\"}, environment)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Инстанс (метрики)",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(engine_uptime_seconds{service=\"$service\",environment=~\"$environment\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(engine_uptime_seconds{service=\"$service\",environment=~\"$environment\"}, instance)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "HTTP-сервер",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 101,
      "title": "HTTP: запросов / с",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_path) (rate(http_handler_rps{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\"}[$__rate_interval]))",
          "legendFormat": "{{http_path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 102,
      "title": "HTTP: 5xx / с",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_path) (rate(http_handler_reply_codes{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\",http_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{http_path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 103,
      "title": "HTTP: p95, максимум по инстансам",
      "type": "timeseries",
      "description": "Готовый p95 userver. Максимум локальных p95, а не общий p95 распределения; служебные ручки исключены.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(http_path) (http_handler_timings{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\",percentile=\"p95\"})",
          "legendFormat": "{{http_path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 104,
      "title": "HTTP: доля 5xx",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_handler_reply_codes{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\",http_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_handler_rps{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_path!~\"/(ping(/ready)?|metrics|tests/.*)\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Процесс",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 201,
      "title": "Доступность /metrics",
      "type": "timeseries",
      "description": "Успех сбора Prometheus. Готовность принимать бизнес-запросы проверяется отдельно через /ping/ready.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 202,
      "title": "Время работы процесса",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "engine_uptime_seconds{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 203,
      "title": "Нагрузка event threads",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "engine_ev_threads_cpu_load_percent{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{ev_thread_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 204,
      "title": "Живые задачи",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "engine_task_processors_tasks_alive{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{task_processor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 205,
      "title": "Задачи в очереди",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "engine_task_processors_tasks_queued{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{task_processor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "HTTP-клиенты",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 301,
      "title": "HTTP-клиенты: ответы / с",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_code) (rate(httpclient_reply_statuses{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{http_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 302,
      "title": "HTTP-клиенты: ошибки / с",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_error) (rate(httpclient_errors{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",http_error!=\"ok\"}[$__rate_interval]))",
          "legendFormat": "{{http_error}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 303,
      "title": "HTTP-клиенты: p95, максимум по инстансам",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(httpclient_timings{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\",percentile=\"p95\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 304,
      "title": "HTTP-клиенты: повторы / с",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(httpclient_retries{service=\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
