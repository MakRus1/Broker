{
  "realm": "broker",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "client": {
      "configs-admin": [
        {
          "name": "configs.read"
        },
        {
          "name": "configs.write"
        },
        {
          "name": "configs.approve"
        }
      ],
      "broker-logistics": [
